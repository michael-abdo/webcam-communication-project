{
  "reaction_time_tests": {
    "simple_rt": {
      "name": "Simple Reaction Time",
      "trials": 10,
      "stimulus": "visual_button",
      "response": "click",
      "delay_range": [1000, 4000],
      "timeout": 5000,
      "metrics": ["reaction_time", "lapses", "variability"]
    },
    "choice_rt": {
      "name": "Choice Reaction Time",
      "trials": 20,
      "stimuli": ["←", "↑", "→", "↓"],
      "response": "arrow_keys",
      "delay_range": [500, 2000],
      "timeout": 3000,
      "metrics": ["reaction_time", "accuracy", "errors"]
    },
    "sustained_attention": {
      "name": "Sustained Attention Test",
      "duration": 120000,
      "target": "X",
      "distractors": ["A", "B", "C", "D", "E", "F", "G", "H"],
      "target_probability": 0.2,
      "presentation_time": 500,
      "isi": 1000,
      "metrics": ["hits", "false_alarms", "misses", "vigilance_decrement"]
    }
  },
  "performance_thresholds": {
    "reaction_time": {
      "excellent": 200,
      "good": 250,
      "average": 350,
      "slow": 500
    },
    "accuracy": {
      "excellent": 0.95,
      "good": 0.85,
      "average": 0.75,
      "poor": 0.65
    },
    "fatigue_indicators": {
      "rt_slowing": 0.1,
      "variability_increase": 0.15,
      "accuracy_decline": 0.1,
      "lapse_threshold": 500
    }
  },
  "fatigue_classification": {
    "normal": {
      "score_range": [0, 0.05],
      "description": "No signs of cognitive fatigue"
    },
    "mild": {
      "score_range": [0.05, 0.15],
      "description": "Early signs of fatigue emerging"
    },
    "moderate": {
      "score_range": [0.15, 0.3],
      "description": "Clear fatigue affecting performance"
    },
    "high": {
      "score_range": [0.3, 1.0],
      "description": "Significant fatigue, consider a break"
    }
  },
  "visualization": {
    "chart_update_interval": 1000,
    "metrics_to_plot": ["avgRT", "accuracy", "fatigueScore"],
    "colors": {
      "reaction_time": "#2196f3",
      "accuracy": "#4caf50",
      "fatigue": "#ff5722"
    }
  }
}