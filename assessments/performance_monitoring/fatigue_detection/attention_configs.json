{
  "attention_tests": {
    "continuous_performance": {
      "name": "Continuous Performance Test",
      "duration": 300000,
      "target_sequence": ["A", "X"],
      "target_probability": 0.2,
      "presentation_interval": 2000,
      "response_window": 1500,
      "metrics": ["hits", "false_alarms", "misses", "d_prime"]
    },
    "vigilance_task": {
      "name": "Vigilance Monitoring",
      "duration": 300000,
      "pause_probability": 0.05,
      "pause_duration_range": [500, 1000],
      "minimum_pause_interval": 3000,
      "dot_velocity": {"x": 2, "y": 1.5},
      "metrics": ["detection_rate", "response_time", "misses"]
    },
    "attention_network": {
      "name": "Attention Network Test",
      "trials": 60,
      "flanker_types": ["congruent", "incongruent", "neutral"],
      "cue_types": ["none", "center", "spatial"],
      "fixation_duration": 400,
      "cue_duration": 100,
      "target_duration": 1700,
      "response_window": 1700,
      "metrics": ["alerting", "orienting", "executive_control"]
    }
  },
  "fatigue_indicators": {
    "focus_threshold": 70,
    "stability_threshold": 70,
    "energy_threshold": 60,
    "lapse_frequency_threshold": 5,
    "onset_criteria": 3,
    "recovery_boost": {
      "focus": 20,
      "energy": 30
    }
  },
  "performance_classifications": {
    "focus_levels": {
      "high": [85, 100],
      "medium": [70, 85],
      "low": [40, 70],
      "critical": [0, 40]
    },
    "stability_status": {
      "stable": [80, 100],
      "mostly_stable": [60, 80],
      "fluctuating": [0, 60]
    },
    "energy_status": {
      "high": [60, 100],
      "moderate": [30, 60],
      "low": [0, 30]
    },
    "vigilance_levels": {
      "high": [0.85, 1.0],
      "moderate": [0.7, 0.85],
      "low": [0, 0.7]
    }
  },
  "visualization": {
    "timeline_duration": 600000,
    "heatmap_grid_size": 20,
    "update_intervals": {
      "timeline": 1000,
      "heatmap": 5000,
      "metrics": 500
    },
    "colors": {
      "focus": "#2196f3",
      "stability": "#4caf50",
      "energy": "#ff9800",
      "fatigue_onset": "#f44336"
    }
  },
  "break_recommendations": {
    "short_break": {
      "duration": 120000,
      "focus_recovery": 20,
      "energy_recovery": 30
    },
    "long_break": {
      "duration": 300000,
      "focus_recovery": 40,
      "energy_recovery": 60
    }
  }
}