{
  "test_id": "fatigue_assessment_v1",
  "title": "Fatigue Level Assessment",
  "description": "Quick assessment to determine current fatigue levels and correlate with PERCLOS data",
  "version": "1.0.0",
  "category": "fatigue",
  "duration_minutes": 5,
  "instructions": "This brief assessment will help calibrate the fatigue detection system. Please answer honestly about how you're feeling right now.",
  "settings": {
    "randomize_questions": false,
    "show_progress": true,
    "allow_skip": false,
    "time_limit_seconds": 300,
    "passing_score": null
  },
  "questions": [
    {
      "id": 1,
      "type": "slider",
      "question": "How tired do you feel right now?",
      "description": "0 = Wide awake, 10 = Extremely tired",
      "required": true,
      "points": 0,
      "tags": ["fatigue-level", "subjective"],
      "validation": {
        "min_value": 0,
        "max_value": 10,
        "step": 0.5
      }
    },
    {
      "id": 2,
      "type": "multiple_choice",
      "question": "How long have you been awake today?",
      "required": true,
      "points": 0,
      "tags": ["time-awake", "context"],
      "options": [
        {"value": "less_than_2", "label": "Less than 2 hours"},
        {"value": "2_to_4", "label": "2-4 hours"},
        {"value": "4_to_8", "label": "4-8 hours"},
        {"value": "8_to_12", "label": "8-12 hours"},
        {"value": "12_to_16", "label": "12-16 hours"},
        {"value": "more_than_16", "label": "More than 16 hours"}
      ]
    },
    {
      "id": 3,
      "type": "multiple_choice",
      "question": "Have you experienced any of these symptoms in the last hour?",
      "description": "Select all that apply",
      "required": true,
      "points": 0,
      "tags": ["symptoms", "physical"],
      "options": [
        {"value": "heavy_eyelids", "label": "Heavy eyelids"},
        {"value": "yawning", "label": "Frequent yawning"},
        {"value": "difficulty_focusing", "label": "Difficulty focusing eyes"},
        {"value": "head_nodding", "label": "Head nodding"},
        {"value": "none", "label": "None of the above"}
      ]
    },
    {
      "id": 4,
      "type": "true_false",
      "question": "I feel alert enough to safely operate a vehicle right now",
      "required": true,
      "points": 0,
      "tags": ["safety", "self-assessment"]
    },
    {
      "id": 5,
      "type": "rating",
      "question": "Rate your current ability to concentrate",
      "required": true,
      "points": 0,
      "tags": ["concentration", "cognitive"],
      "validation": {
        "min_value": 1,
        "max_value": 5,
        "step": 1
      },
      "options": [
        {"value": "1", "label": "Very Poor"},
        {"value": "2", "label": "Poor"},
        {"value": "3", "label": "Fair"},
        {"value": "4", "label": "Good"},
        {"value": "5", "label": "Excellent"}
      ]
    },
    {
      "id": 6,
      "type": "multiple_choice",
      "question": "What best describes your current state?",
      "required": true,
      "points": 0,
      "tags": ["state", "overall"],
      "options": [
        {"value": "fully_alert", "label": "Fully alert and energetic"},
        {"value": "alert_functioning", "label": "Alert but not at peak"},
        {"value": "slightly_drowsy", "label": "Slightly drowsy but functional"},
        {"value": "drowsy_struggling", "label": "Drowsy and struggling to stay alert"},
        {"value": "fighting_sleep", "label": "Fighting to stay awake"}
      ]
    }
  ],
  "scoring": {
    "type": "custom",
    "description": "Scores are used to calibrate PERCLOS thresholds, not for pass/fail"
  },
  "feedback": {
    "show_correct_answers": false,
    "immediate": false,
    "final_message": {
      "excellent": {
        "min_score": 80,
        "message": "You appear to be well-rested and alert. The system will calibrate accordingly."
      },
      "good": {
        "min_score": 50,
        "message": "You're showing some signs of fatigue. The system will monitor your alertness levels."
      },
      "needs_improvement": {
        "min_score": 0,
        "message": "You're showing significant signs of fatigue. Consider taking a break if possible."
      }
    }
  }
}