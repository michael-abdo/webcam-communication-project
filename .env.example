# Environment variables for Baseline Capture System

# AWS S3 Configuration (optional - will use local storage if not set)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name

# Port configuration (set by Heroku)
# PORT=8000

# Python environment
# PYTHONUNBUFFERED=1

# Zoom RTMS integration
ZM_RTMS_CLIENT=your-zoom-client-id
ZM_RTMS_SECRET=your-zoom-client-secret
RTMS_WEBHOOK_PATH=/rtms/webhook

# Shared capture API token for RTMS ingestion service
CAPTURE_API_TOKEN=your-shared-token

# Remote RTMS UI (zoom-test-rtms) for proxying dashboard requests
RTMS_PROXY_BASE_URL=https://zoom-test-rtms-5898b0134dc2.herokuapp.com
