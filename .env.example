# Environment variables for Baseline Capture System

# AWS S3 Configuration (optional - will use local storage if not set)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name

# Port configuration (set by Heroku)
# PORT=8000

# Python environment
# PYTHONUNBUFFERED=1